{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deep Music Producer",
  "version": "0.1.0",
  "identifier": "cl.deepanalytica.deepmusicproducer",
  "build": {
    "frontendDist": "../../../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Deep Music Producer",
        "width": 1600,
        "height": 1000,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
